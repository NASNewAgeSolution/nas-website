import { useState, useEffect, useRef } from 'react';
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { 
  Mail, 
  Phone, 
  MapPin, 
  Send, 
  CheckCircle,
  Linkedin,
  Facebook,
  MessageCircle
} from 'lucide-react';
import { CONTACT_CONFIG } from '../App';

gsap.registerPlugin(ScrollTrigger);

const Contact = () => {
  const [formData, setFormData] = useState({
    name: '',
    email: '',
    company: '',
    message: '',
  });
  const [isSubmitted, setIsSubmitted] = useState(false);
  const heroRef = useRef<HTMLDivElement>(null);
  const formRef = useRef<HTMLDivElement>(null);
  const infoRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const ctx = gsap.context(() => {
      // Hero animation
      gsap.from('.contact-hero-content', {
        scrollTrigger: {
          trigger: heroRef.current,
          start: 'top 80%',
          end: 'top 40%',
          scrub: 1,
        },
        y: 60,
        opacity: 0,
      });

      // Form animation
      gsap.from('.contact-form', {
        scrollTrigger: {
          trigger: formRef.current,
          start: 'top 80%',
          end: 'top 40%',
          scrub: 1,
        },
        x: -60,
        opacity: 0,
      });

      // Info animation
      gsap.from('.contact-info', {
        scrollTrigger: {
          trigger: infoRef.current,
          start: 'top 80%',
          end: 'top 40%',
          scrub: 1,
        },
        x: 60,
        opacity: 0,
      });
    });

    return () => ctx.revert();
  }, []);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    // Simulate form submission
    setIsSubmitted(true);
    setTimeout(() => {
      setIsSubmitted(false);
      setFormData({ name: '', email: '', company: '', message: '' });
    }, 3000);
  };

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {
    setFormData({
      ...formData,
      [e.target.name]: e.target.value,
    });
  };

  const contactInfo = [
    {
      icon: Phone,
      label: 'Phone',
      value: CONTACT_CONFIG.phoneNumber,
      href: `tel:${CONTACT_CONFIG.phoneNumber}`,
    },
    {
      icon: Mail,
      label: 'Email',
      value: CONTACT_CONFIG.email,
      href: `mailto:${CONTACT_CONFIG.email}`,
    },
    {
      icon: MapPin,
      label: 'Address',
      value: CONTACT_CONFIG.address,
      href: '#',
    },
  ];

  // WhatsApp link
  const whatsappUrl = `https://wa.me/${CONTACT_CONFIG.whatsappNumber}?text=${encodeURIComponent("Hi N.A.S, I'd like to know more about your IT services.")}`;

  return (
    <main className="bg-[#070B14] pt-20">
      {/* Hero Section */}
      <section
        ref={heroRef}
        className="relative min-h-[50vh] flex items-center overflow-hidden grain-overlay"
      >
        {/* Background */}
        <div className="absolute inset-0 z-0">
          <img
            src="/contact_building.jpg"
            alt="Modern Building"
            className="w-full h-full object-cover opacity-20"
          />
          <div className="absolute inset-0 bg-gradient-to-r from-[#070B14] via-[#070B14]/80 to-transparent" />
          <div className="absolute inset-0 bg-gradient-to-t from-[#070B14] via-transparent to-[#070B14]/50" />
        </div>

        {/* Geometric Panels */}
        <div className="absolute top-0 left-0 w-[20vw] h-[25vh] bg-[#0F172A]/80 border-r border-b border-[rgba(244,247,255,0.08)] z-10" />
        <div className="absolute top-0 right-0 w-[20vw] h-[25vh] bg-[#0F172A]/80 border-l border-b border-[rgba(244,247,255,0.08)] z-10" />

        {/* Content */}
        <div className="relative z-20 w-full px-6 lg:px-12 py-32">
          <div className="max-w-4xl contact-hero-content">
            <span className="micro-label block mb-6 text-[#2D6BFF]">CONTACT</span>
            <h1 className="headline-xl text-[#F4F7FF] mb-8">
              Let&apos;s Talk
              <br />
              <span className="text-gradient">IT Solutions</span>
            </h1>
            <p className="body-text max-w-2xl text-lg">
              Have a question or need a quote? We&apos;re here to help. Reach out to us 
              and we&apos;ll get back to you as soon as possible.
            </p>
          </div>
        </div>
      </section>

      {/* Contact Form Section */}
      <section
        ref={formRef}
        className="relative py-32 bg-[#0B1222] grain-overlay"
      >
        <div className="w-full px-6 lg:px-12">
          <div className="max-w-7xl mx-auto">
            <div className="grid lg:grid-cols-2 gap-16">
              {/* Form */}
              <div className="contact-form">
                <span className="micro-label block mb-4 text-[#2D6BFF]">SEND A MESSAGE</span>
                <h2 className="headline-lg text-[#F4F7FF] mb-8">
                  Get In Touch
                </h2>

                {isSubmitted ? (
                  <div className="p-8 bg-[#070B14] border border-[#2D6BFF]/30 text-center">
                    <CheckCircle className="w-16 h-16 text-[#2D6BFF] mx-auto mb-4" />
                    <h3 className="text-2xl font-bold text-[#F4F7FF] mb-2">
                      Message Sent!
                    </h3>
                    <p className="text-[#A7B3D1]">
                      Thank you for reaching out. We&apos;ll get back to you within one business day.
                    </p>
                  </div>
                ) : (
                  <form onSubmit={handleSubmit} className="space-y-6">
                    <div>
                      <label htmlFor="name" className="block text-sm font-medium text-[#F4F7FF] mb-2">
                        Name *
                      </label>
                      <input
                        type="text"
                        id="name"
                        name="name"
                        value={formData.name}
                        onChange={handleChange}
                        required
                        className="w-full px-4 py-3 bg-[#070B14] border border-[rgba(244,247,255,0.08)] text-[#F4F7FF] placeholder-[#A7B3D1]/50 focus:border-[#2D6BFF] focus:outline-none transition-colors"
                        placeholder="Your name"
                      />
                    </div>

                    <div>
                      <label htmlFor="email" className="block text-sm font-medium text-[#F4F7FF] mb-2">
                        Email *
                      </label>
                      <input
                        type="email"
                        id="email"
                        name="email"
                        value={formData.email}
                        onChange={handleChange}
                        required
                        className="w-full px-4 py-3 bg-[#070B14] border border-[rgba(244,247,255,0.08)] text-[#F4F7FF] placeholder-[#A7B3D1]/50 focus:border-[#2D6BFF] focus:outline-none transition-colors"
                        placeholder="your@email.com"
                      />
                    </div>

                    <div>
                      <label htmlFor="company" className="block text-sm font-medium text-[#F4F7FF] mb-2">
                        Company
                      </label>
                      <input
                        type="text"
                        id="company"
                        name="company"
                        value={formData.company}
                        onChange={handleChange}
                        className="w-full px-4 py-3 bg-[#070B14] border border-[rgba(244,247,255,0.08)] text-[#F4F7FF] placeholder-[#A7B3D1]/50 focus:border-[#2D6BFF] focus:outline-none transition-colors"
                        placeholder="Your company name"
                      />
                    </div>

                    <div>
                      <label htmlFor="message" className="block text-sm font-medium text-[#F4F7FF] mb-2">
                        Message *
                      </label>
                      <textarea
                        id="message"
                        name="message"
                        value={formData.message}
                        onChange={handleChange}
                        required
                        rows={5}
                        className="w-full px-4 py-3 bg-[#070B14] border border-[rgba(244,247,255,0.08)] text-[#F4F7FF] placeholder-[#A7B3D1]/50 focus:border-[#2D6BFF] focus:outline-none transition-colors resize-none"
                        placeholder="Tell us about your IT needs..."
                      />
                    </div>

                    <button
                      type="submit"
                      className="btn-primary w-full group"
                    >
                      Send Message
                      <Send className="ml-2 w-4 h-4 transition-transform group-hover:translate-x-1" />
                    </button>
                  </form>
                )}
              </div>

              {/* Contact Info */}
              <div className="contact-info" ref={infoRef}>
                <span className="micro-label block mb-4 text-[#2D6BFF]">CONTACT INFO</span>
                <h2 className="headline-lg text-[#F4F7FF] mb-8">
                  Other Ways To Reach Us
                </h2>

                <div className="space-y-6 mb-12">
                  {contactInfo.map((info, index) => (
                    <a
                      key={index}
                      href={info.href}
                      className="flex items-start gap-4 p-6 bg-[#070B14] border border-[rgba(244,247,255,0.08)] hover:border-[#2D6BFF]/50 transition-all duration-300 group"
                    >
                      <div className="w-12 h-12 bg-[#2D6BFF]/10 rounded-sm flex items-center justify-center flex-shrink-0 group-hover:bg-[#2D6BFF]/20 transition-colors">
                        <info.icon className="w-6 h-6 text-[#2D6BFF]" />
                      </div>
                      <div>
                        <p className="text-sm text-[#A7B3D1] mb-1">{info.label}</p>
                        <p className="text-[#F4F7FF] font-medium">{info.value}</p>
                      </div>
                    </a>
                  ))}

                  {/* WhatsApp */}
                  <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="flex items-start gap-4 p-6 bg-[#25D366]/10 border border-[#25D366]/30 hover:border-[#25D366] transition-all duration-300 group"
                  >
                    <div className="w-12 h-12 bg-[#25D366]/20 rounded-sm flex items-center justify-center flex-shrink-0 group-hover:bg-[#25D366]/30 transition-colors">
                      <MessageCircle className="w-6 h-6 text-[#25D366]" />
                    </div>
                    <div>
                      <p className="text-sm text-[#A7B3D1] mb-1">WhatsApp</p>
                      <p className="text-[#F4F7FF] font-medium">Chat with us on WhatsApp</p>
                    </div>
                  </a>
                </div>

                {/* Social Links */}
                <div>
                  <p className="text-sm text-[#A7B3D1] mb-4">Follow us on social media</p>
                  <div className="flex gap-4">
                    <a
                      href={CONTACT_CONFIG.linkedinUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="w-12 h-12 bg-[#070B14] border border-[rgba(244,247,255,0.08)] flex items-center justify-center text-[#A7B3D1] hover:text-[#2D6BFF] hover:border-[#2D6BFF]/50 transition-all duration-300"
                      aria-label="LinkedIn"
                    >
                      <Linkedin className="w-5 h-5" />
                    </a>
                    <a
                      href={CONTACT_CONFIG.facebookUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="w-12 h-12 bg-[#070B14] border border-[rgba(244,247,255,0.08)] flex items-center justify-center text-[#A7B3D1] hover:text-[#2D6BFF] hover:border-[#2D6BFF]/50 transition-all duration-300"
                      aria-label="Facebook"
                    >
                      <Facebook className="w-5 h-5" />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Map Section */}
      <section className="relative py-24 bg-[#070B14] grain-overlay">
        <div className="w-full px-6 lg:px-12">
          <div className="max-w-7xl mx-auto">
            <div className="text-center mb-12">
              <span className="micro-label block mb-4 text-[#2D6BFF]">VISIT US</span>
              <h2 className="headline-lg text-[#F4F7FF] mb-6">
                Our Location
              </h2>
            </div>

            <div className="p-8 bg-[#0B1222] border border-[rgba(244,247,255,0.08)] text-center max-w-2xl mx-auto">
              <MapPin className="w-8 h-8 text-[#2D6BFF] mx-auto mb-4" />
              <h3 className="text-lg font-semibold text-[#F4F7FF] mb-2">N.A.S Headquarters</h3>
              <p className="text-[#A7B3D1]">
                {CONTACT_CONFIG.address}
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* CTA Section */}
      <section className="relative py-24 bg-[#0B1222] grain-overlay">
        <div className="w-full px-6 lg:px-12">
          <div className="max-w-4xl mx-auto text-center">
            <span className="micro-label block mb-4 text-[#2D6BFF]">READY TO GET STARTED?</span>
            <h2 className="headline-lg text-[#F4F7FF] mb-6">
              Not Sure What You Need?
            </h2>
            <p className="body-text max-w-2xl mx-auto mb-10">
              Let&apos;s have a conversation. We&apos;ll assess your setup and recommend 
              the right solutions at the right price.
            </p>
            <div className="flex flex-wrap justify-center gap-4">
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                className="btn-primary inline-flex group"
              >
                <MessageCircle className="mr-2 w-5 h-5" />
                Chat on WhatsApp
              </a>
              <a href={`mailto:${CONTACT_CONFIG.email}`} className="btn-secondary">
                Email Us
              </a>
            </div>
          </div>
        </div>
      </section>

      {/* Footer */}
      <footer className="bg-[#070B14] border-t border-[rgba(244,247,255,0.08)] py-16">
        <div className="w-full px-6 lg:px-12">
          <div className="max-w-7xl mx-auto">
            <div className="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
              <div className="lg:col-span-1">
                <img
                  src="/logo.png"
                  alt="N.A.S"
                  className="w-32 h-auto mb-4"
                />
                <p className="text-[#A7B3D1] text-sm leading-relaxed">
                  Complete IT solutions for your business. From daily tech support to full network installations.
                </p>
              </div>
              <div>
                <h4 className="text-[#F4F7FF] font-semibold mb-4">Services</h4>
                <ul className="space-y-3">
                  <li><a href="/services" className="text-[#A7B3D1] hover:text-[#2D6BFF] text-sm transition-colors">Remote IT Support</a></li>
                  <li><a href="/services" className="text-[#A7B3D1] hover:text-[#2D6BFF] text-sm transition-colors">Email & Domain Setup</a></li>
                  <li><a href="/services" className="text-[#A7B3D1] hover:text-[#2D6BFF] text-sm transition-colors">Network & WiFi</a></li>
                  <li><a href="/services" className="text-[#A7B3D1] hover:text-[#2D6BFF] text-sm transition-colors">CCTV & Security</a></li>
                  <li><a href="/services" className="text-[#A7B3D1] hover:text-[#2D6BFF] text-sm transition-colors">Computer Repairs</a></li>
                </ul>
              </div>
              <div>
                <h4 className="text-[#F4F7FF] font-semibold mb-4">Company</h4>
                <ul className="space-y-3">
                  <li><a href="/about" className="text-[#A7B3D1] hover:text-[#2D6BFF] text-sm transition-colors">About Us</a></li>
                  <li><a href="/pricing" className="text-[#A7B3D1] hover:text-[#2D6BFF] text-sm transition-colors">Pricing</a></li>
                  <li><a href="/contact" className="text-[#A7B3D1] hover:text-[#2D6BFF] text-sm transition-colors">Contact</a></li>
                </ul>
              </div>
              <div>
                <h4 className="text-[#F4F7FF] font-semibold mb-4">Contact</h4>
                <ul className="space-y-3">
                  <li><a href={`tel:${CONTACT_CONFIG.phoneNumber}`} className="text-[#A7B3D1] hover:text-[#2D6BFF] text-sm transition-colors">{CONTACT_CONFIG.phoneNumber}</a></li>
                  <li><a href={`mailto:${CONTACT_CONFIG.email}`} className="text-[#A7B3D1] hover:text-[#2D6BFF] text-sm transition-colors">{CONTACT_CONFIG.email}</a></li>
                  <li><span className="text-[#A7B3D1] text-sm">{CONTACT_CONFIG.address}</span></li>
                </ul>
              </div>
            </div>
            <div className="pt-8 border-t border-[rgba(244,247,255,0.08)] flex flex-col md:flex-row justify-between items-center gap-4">
              <p className="text-[#A7B3D1] text-sm">
                © 2026 N.A.S. All rights reserved.
              </p>
              <div className="flex gap-6">
                <a href={CONTACT_CONFIG.linkedinUrl} target="_blank" rel="noopener noreferrer" className="text-[#A7B3D1] hover:text-[#2D6BFF] text-sm transition-colors">LinkedIn</a>
                <a href={CONTACT_CONFIG.facebookUrl} target="_blank" rel="noopener noreferrer" className="text-[#A7B3D1] hover:text-[#2D6BFF] text-sm transition-colors">Facebook</a>
              </div>
            </div>
          </div>
        </div>
      </footer>
    </main>
  );
};

export default Contact;
